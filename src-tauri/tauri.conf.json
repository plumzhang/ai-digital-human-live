{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "数字人直播中控台",
  "version": "0.1.0",
  "identifier": "com.innotechx.digitalhuman.live",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "数字人直播中控台", "width": 1500, "height": 920, "minWidth": 1100, "minHeight": 700 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/songs/videos/**", "$APPDATA/songs/directors/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "resources": ["resources/dyhub/**/*", "resources/node.exe"]
  }
}
